[Unit]
Description=GameLink STUN listener firewall rules
After=network-online.target iptables.service
Before=gamelink-stun.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/gamelink-stun/firewall.sh start
ExecStop=/bin/bash /opt/gamelink-stun/firewall.sh stop

[Install]
WantedBy=multi-user.target
